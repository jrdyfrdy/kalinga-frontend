# API Configuration
VITE_API_URL=http://localhost:8000
# Primary OSRM endpoint used by the frontend. For development with a local
# OSRM server, set the value to your local instance (example below).
# Do NOT commit your real .env file to the repository; update your local
# `.env` instead.
VITE_OSRM_SERVER=http://localhost:5050

# OpenWeatherMap API key — get yours at https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Node/Express backend (node-backend/, PORT=5000 by default)
VITE_NODE_API_URL=http://localhost:5000

# Laravel Reverb (realtime). Must match backend/.env REVERB_* values.
VITE_REVERB_APP_KEY=your_reverb_app_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Firebase (online training courses, progress and uploads)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
